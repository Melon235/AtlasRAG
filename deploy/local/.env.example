# Copy this file to deploy/local/.env and replace every credential placeholder.
ATLASRAG_BIND_HOST=127.0.0.1

POSTGRES_DB=atlasrag
POSTGRES_USER=atlasrag
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password

SEARXNG_PORT=8080
SEARXNG_SECRET=replace-with-local-searxng-secret-at-least-32-characters

ATLASRAG_POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${ATLASRAG_BIND_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ATLASRAG_REDIS_URL=redis://${ATLASRAG_BIND_HOST}:${REDIS_PORT}/0
ATLASRAG_TEST_REDIS_URL=redis://${ATLASRAG_BIND_HOST}:${REDIS_PORT}/15
ATLASRAG_MILVUS_URI=http://${ATLASRAG_BIND_HOST}:${MILVUS_PORT}
ATLASRAG_MILVUS_COLLECTION=atlas_chunks
ATLASRAG_EMBEDDING_DIMENSION=1024
ATLASRAG_SEARXNG_URL=http://${ATLASRAG_BIND_HOST}:${SEARXNG_PORT}/

ATLASRAG_INFRA_WAIT_TIMEOUT_SECONDS=300
ATLASRAG_INFRA_PROBE_TIMEOUT_SECONDS=5
ATLASRAG_INFRA_POLL_SECONDS=1
